# Contact form delivery (Resend). Without RESEND_API_KEY, production returns
# "MAIL NOT CONFIGURED" and dev logs the ping to the console instead.
RESEND_API_KEY=
# Where pings land. Defaults to the address in the site footer.
CONTACT_TO=
# Optional verified sender. Defaults to Resend's onboarding sender, which only
# delivers to the Resend account owner's inbox (enough for a personal site).
CONTACT_FROM=
